<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      nuget.org satisfies every configuration from Revit 2020 through 2025.

      Revit 2026 and 2027 additionally need DynamoVisualProgramming.Revit 3.6.0+ and 27.0.0+,
      which are published only to https://nuget.pkg.github.com/johnpierson/index.json. That feed is
      deliberately NOT listed here: GitHub Packages answers 401 rather than 404 to unauthenticated
      callers, and NuGet treats a 401 from any configured source as fatal (NU1301), so listing it
      made every configuration unrestorable for anyone without a token, including the 2020-2025
      builds that never needed it.

      CI adds the feed with credentials (see .github/workflows/build.yml). To build R26/R27
      locally, add it yourself with a personal access token carrying the read:packages scope:

        dotnet nuget add source https://nuget.pkg.github.com/johnpierson/index.json
             /name johnpierson-github /username YOUR_GITHUB_NAME /password YOUR_PAT

      (written with slashes above because an XML comment may not contain a double hyphen)
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
