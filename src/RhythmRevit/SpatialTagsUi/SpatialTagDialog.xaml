<Window
    Name="Win"
    x:Class="Rhythm.SpatialTagsUi.SpatialTagDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="680"
    Width="520"
    MinHeight="560"
    MinWidth="460"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Style="{DynamicResource Interlude.Window}"
    Title="{Binding PluginVersion, FallbackValue='3d Spatial Tags'}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RhythmRevit;component/SpatialTagsUi/Themes/InterludeLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="b2v" />

            <!--
                The status lines wiggle when they change, which is how the original tool drew the
                eye to a count that had just moved.

                A shake rather than the original rotation: these lines wrap to two or three lines
                now, and a wrapped paragraph pivoting about its left edge swings its last words
                clean outside the card. A few pixels sideways reads the same and stays in bounds.

                No TargetName either — the animation drives the transform of whichever element
                begins it, so both lines wiggle themselves instead of both wiggling the first.
            -->
            <Storyboard x:Key="WiggleStoryboard" FillBehavior="Stop">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                 From="6"
                                 To="0"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut"
                                     Oscillations="4"
                                     Springiness="3" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- One row of the form: a caption in a fixed column, the control beside it. -->
            <Style x:Key="FieldRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Header: what the dialog is, and what it is about to do. -->
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
            <TextBlock Style="{StaticResource Interlude.SectionHeader}"
                       FontSize="{DynamicResource Interlude.FontSizeHeading}"
                       Text="{Binding TitleText, FallbackValue='3d Room Tags'}" />
            <TextBlock Style="{StaticResource Interlude.HelpText}"
                       Margin="0,4,0,0"
                       Text="Place a 3d tag family at every placed room or space in the chosen phase, and update the ones already there." />
        </StackPanel>

        <!-- Footer: the credit mark on the left, the two commands on the right. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Interlude.Surface}"
                BorderBrush="{DynamicResource Interlude.Border}"
                BorderThickness="0,2,0,0"
                Padding="16,10,16,14">
            <DockPanel LastChildFill="False">
                <!--
                    A Button rather than an Image with a MouseDown handler. The mark is a
                    link, and a link that only answers to a mouse cannot be reached at all
                    from the keyboard or announced as activatable by a screen reader. The
                    chrome is stripped back to the bare image so it still looks like a mark.
                -->
                <Button DockPanel.Dock="Left"
                        Click="LicenceLink_OnClick"
                        AutomationProperties.Name="design tech unraveled — open the licence on GitHub"
                        TabIndex="9"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="design tech unraveled — opens the licence on GitHub">
                    <Image Source="/RhythmRevit;component/SpatialTagsUi/Resources/DesignTechUnraveledMark_512x383.png"
                           Height="30" />
                </Button>

                <Button DockPanel.Dock="Right"
                        MinWidth="150"
                        Content="Create / Update Tags"
                        AutomationProperties.Name="Create or update tags"
                        TabIndex="7"
                        Style="{StaticResource Interlude.PrimaryButton}"
                        IsDefault="True"
                        Command="{Binding Run, Mode=OneWay}"
                        CommandParameter="{Binding ElementName=Win}"
                        IsEnabled="{Binding CanRun, FallbackValue=False}" />

                <Button DockPanel.Dock="Right"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Content="Close"
                        AutomationProperties.Name="Close"
                        TabIndex="8"
                        IsCancel="True"
                        Command="{Binding Close, Mode=OneWay}"
                        CommandParameter="{Binding ElementName=Win}" />
            </DockPanel>
        </Border>

        <TabControl Margin="16,0,16,0">

            <TabItem Header="Tag creation">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="0,12,4,12">

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Interlude.FieldLabel}"
                                       Text="Target elements" />
                            <ComboBox Grid.Column="1"
                                      Name="TargetComboBox"
                                      AutomationProperties.Name="Target elements"
                                      AutomationProperties.HelpText="Whether to tag rooms or MEP spaces."
                                      TabIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding TargetIndex, Mode=TwoWay, FallbackValue=0}"
                                      SelectionChanged="TargetChanged">
                                <ComboBoxItem Content="Rooms" />
                                <ComboBoxItem Content="Spaces" />
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Interlude.FieldLabel}"
                                       Text="Read from a link" />
                            <StackPanel Grid.Column="1">
                                <CheckBox Name="FromLinkCheckbox"
                                          AutomationProperties.Name="Use a linked model"
                                          TabIndex="1"
                                          Content="{Binding FromLinkCaption, FallbackValue='Use a linked model'}"
                                          IsChecked="{Binding FromLink, Mode=TwoWay, FallbackValue=False}"
                                          IsEnabled="{Binding HasLinks, FallbackValue=False}"
                                          Checked="ToggleButton_OnChecked"
                                          Unchecked="ToggleButton_OnChecked" />
                                <!--
                                    An ItemTemplate rather than DisplayMemberPath. The two are
                                    equivalent in the drop-down list, but the closed box draws
                                    SelectionBoxItemTemplate, which WPF derives from ItemTemplate
                                    alone — with only a DisplayMemberPath set it renders whatever
                                    the item's ToString gives, and a Revit element's is its type
                                    name.
                                -->
                                <ComboBox Name="LinkComboBox"
                                          Margin="0,8,0,0"
                                          AutomationProperties.Name="Linked model"
                                          TabIndex="2"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding LinkIndex, Mode=TwoWay}"
                                          ItemsSource="{Binding Links}"
                                          Visibility="{Binding FromLink, Converter={StaticResource b2v}}"
                                          SelectionChanged="Link_OnSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Interlude.FieldLabel}"
                                       Text="Phase" />
                            <ComboBox Grid.Column="1"
                                      Name="PhaseComboBox"
                                      AutomationProperties.Name="Phase"
                                      TabIndex="3"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Phases}"
                                      SelectionChanged="Selector_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Interlude.FieldLabel}"
                                       Text="Tag family type" />
                            <StackPanel Grid.Column="1">
                                <ComboBox Name="FamilySymbolComboBox"
                                          AutomationProperties.Name="Tag family type"
                                          TabIndex="4"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding FamilySymbolIndex, Mode=TwoWay}"
                                          ItemsSource="{Binding RoomTagFamilySymbols}"
                                          SelectionChanged="FamilySymbolSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="FamilyName" />
                                                        <Binding Path="Name" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Interlude.ErrorText}"
                                           Margin="0,4,0,0"
                                           Text="No 3d spatial tag family is loaded in this model."
                                           Visibility="{Binding HasNoFamilySymbols, Converter={StaticResource b2v}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Interlude.FieldLabel}"
                                       Text="Existing tags" />
                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Update the ones already placed"
                                          AutomationProperties.Name="Update the tags already placed"
                                          TabIndex="5"
                                          IsChecked="{Binding UpdateExisting, Mode=TwoWay, FallbackValue=True}" />
                                <TextBlock Style="{StaticResource Interlude.HelpText}"
                                           Margin="0,4,0,0"
                                           Text="Suggested. Previous tags are matched by the spatial element id stored on the tag family; leave this off and every run places new tags." />
                            </StackPanel>
                        </Grid>

                        <!-- Status: what the current selection would actually tag. -->
                        <!-- Right and bottom margins clear the card's own four-pixel hard shadow. -->
                        <!--
                            Announced as a live region: the counts and warnings here change in
                            response to a selection made elsewhere in the dialog, so a screen
                            reader user would otherwise never learn that the thing they just
                            chose has anything to say about it.
                        -->
                        <Border Style="{StaticResource Interlude.CardWithShadow}"
                                Margin="0,6,6,6"
                                AutomationProperties.Name="Status"
                                AutomationProperties.LiveSetting="Polite"
                                Visibility="{Binding HasStatus, Converter={StaticResource b2v}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Interlude.SectionHeader}"
                                           FontSize="{DynamicResource Interlude.FontSizeSmall}"
                                           Text="S T A T U S" />

                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding FlyOutText, NotifyOnTargetUpdated=True, FallbackValue=''}"
                                           Visibility="{Binding FlyOutVisibility, Converter={StaticResource b2v}}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard Storyboard="{StaticResource WiggleStoryboard}" />
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>

                                <TextBlock Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Interlude.Warning}"
                                           Text="{Binding UnboundedFlyOutText, NotifyOnTargetUpdated=True, FallbackValue=''}"
                                           Visibility="{Binding UnboundedFlyOutVisibility, Converter={StaticResource b2v}}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard Storyboard="{StaticResource WiggleStoryboard}" />
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>

                                <TextBlock Style="{StaticResource Interlude.ErrorText}"
                                           Margin="0,6,0,0"
                                           Text="{Binding ErrorText, FallbackValue=''}"
                                           Visibility="{Binding HasError, Converter={StaticResource b2v}}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="0,12,4,12">
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource Interlude.FieldLabel}"
                                   Text="Text height" />
                        <StackPanel Grid.Column="1">
                            <TextBox AutomationProperties.Name="Text height"
                                     AutomationProperties.HelpText="A height in feet and inches, for example 2 feet 0 inches."
                                     TabIndex="6"
                                     Text="{Binding TextHeightString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <!--
                                Said plainly, because "model units" was not true: the parser
                                only ever accepted imperial feet-and-inches notation, so a
                                metric user reading that entered a number and got an error
                                with no hint as to why.
                            -->
                            <TextBlock Style="{StaticResource Interlude.HelpText}"
                                       Margin="0,4,0,0"
                                       Text="In feet and inches — for example 2' 0&quot;, 6&quot;, or 1' 3/4&quot;. Applied to the selected tag family type when tags are created. Leave it blank to keep the family's own height." />
                            <TextBlock Style="{StaticResource Interlude.ErrorText}"
                                       Margin="0,4,0,0"
                                       Text="That is not a length this tool can read; the tag family's own text height will be left alone."
                                       Visibility="{Binding HasTextHeightError, Converter={StaticResource b2v}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
