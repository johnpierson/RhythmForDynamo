	 <ItemGroup>
	    <PackageReference Include="DynamoVisualProgramming.Revit" Version="$(DynVersion).*" />
        <PackageReference Include="DynamoVisualProgramming.DynamoCoreNodes" Version="$(DynVersion).*" />
        <PackageReference Include="Prism" Version="4.1.0.0" />
        <PackageReference Include="System.Buffers" Version="4.5.1" />
        <PackageReference Include="System.Memory" Version="4.5.4" />
        <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
		<PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitVersion).*-*" />
        <PackageReference Include="DynamoVisualProgramming.Core" Version="$(DynVersion).*" />
		<PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="$(DynVersion).*" />
		<!-- Compile-time only: Revit supplies Newtonsoft.Json at runtime, so it must not be
		     copied to the output. Referencing the package rather than the Revit install keeps
		     the project buildable on a machine without Revit, such as a CI runner. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" ExcludeAssets="runtime" />
	 </ItemGroup>
	  <ItemGroup Condition="'$(Configuration)|$(Platform)'!='Release R25|AnyCPU' And '$(Configuration)|$(Platform)'!='Release R26|AnyCPU' And '$(Configuration)|$(Platform)'!='Debug R25|AnyCPU' And '$(Configuration)|$(Platform)'!='Debug R26|AnyCPU' And '$(Configuration)|$(Platform)'!='Release R27|AnyCPU' And '$(Configuration)|$(Platform)'!='Debug R27|AnyCPU'">
		<PackageReference Include="CommonServiceLocator" Version="1.0" />
      
        <PackageReference Include="NUnit" Version="2.6.3" />
        <PackageReference Include="System.Collections.Immutable" Version="1.7.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)|$(Platform)'=='Release R25|AnyCPU' Or '$(Configuration)|$(Platform)'=='Debug R25|AnyCPU' Or '$(Configuration)|$(Platform)'=='Release R26|AnyCPU' Or '$(Configuration)|$(Platform)'=='Debug R26|AnyCPU' Or '$(Configuration)|$(Platform)'=='Release R27|AnyCPU' Or '$(Configuration)|$(Platform)'=='Debug R27|AnyCPU'">
        <PackageReference Include="CommonServiceLocator" Version="2.0.7" />
        
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    </ItemGroup>
	
	<!-- RhythmUI compiles against the RhythmRevit build for the same Revit year. deploy/ is
	     tracked in git, so this path resolves on any clone and on a CI runner; it replaces eight
	     per-configuration copies of an absolute path that existed on one developer's machine only.
	     Build RhythmRevit for the matching configuration before building this project.
	     Private=False: RhythmRevit.dll is deployed by its own project and must not be copied here,
	     where the CopyFiles target's *.xml glob would sweep its doc file back into deploy/. -->
	<ItemGroup>
		<Reference Include="RhythmRevit">
	      <HintPath>$(ProjectDir)..\..\deploy\$(RevitVersion)\RhythmRevit.dll</HintPath>
	      <Private>False</Private>
        </Reference>
	</ItemGroup>
	
	<Target Name="CopyFiles" AfterTargets="CoreBuild">
        <Message Text="Build Revit Version $(RevitVersion)" Importance="high" />
        <ItemGroup>
            <AssemblyFiles Include="$(TargetDir)RhythmUI.dll" />
            <AssemblyFiles Include="$(TargetDir)*.xml" />
        </ItemGroup>
        <Message Text="Copying From $(TargetDir) To $(ProjectDir)..\..\deploy\$(RevitVersion)" Importance="high" />
        <Copy SourceFiles="@(AssemblyFiles)" DestinationFolder="$(ProjectDir)..\..\deploy\$(RevitVersion)" />
        <Message Text="Copied Completed" Importance="high" />
    </Target>
	
</Project>